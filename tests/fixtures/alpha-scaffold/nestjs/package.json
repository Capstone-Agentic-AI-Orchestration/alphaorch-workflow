{
  "name": "fixture-nestjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:cov": "jest --coverage --coverageReporters=json-summary --coverageReporters=text",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "@nestjs/testing": "^11.0.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
